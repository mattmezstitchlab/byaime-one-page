+// FIXTURE — constantes locales de classes (pont §10, angle mort n°9).
+// Le défaut vit dans la constante ; il est facturé PAR USAGE, à la ligne de
+// l'usage. Ce qui n'a pas de littéral local reste NON RÉSOLU, jamais deviné.
+//
+//  inputClass  → focus-visible:outline-none sans ring : écart FOCUS, utilisé 2× → 2 écarts
+//  okClass     → paire valide : 0 écart, utilisé 1×
+//  tpl         → gabarit avec ${…} : le segment est compté non résolu (1), le reste jugé
+//  twice       → redéclaré : NON RÉSOLU (1), on ne choisit pas entre deux valeurs
+//  cls (prop)  → NON RÉSOLU (1)
+//  imported    → NON RÉSOLU (1)
+// ATTENDU : FOCUS = 2 · non résolu = 4
+const inputClass = "w-full focus-visible:outline-none focus:border-b";
+const okClass = "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring";
+const tpl = `rounded-md ${dynamic}`;
+let twice = "outline-none";
+let twice = "ring-2";
+import { imported } from "./elsewhere";
+
+export default function App({ cls }) {
+  return (
+    <div>
+      <h1>Constantes de classes</h1>
+      <input className={inputClass} />
+      <input className={inputClass} />
+      <button type="button" className={okClass}>OK</button>
+      <span className={tpl} />
+      <i className={cls} />
+      <b className={twice} />
+      <em className={imported} />
+    </div>
+  );
+}
