+/* ══ Constantes de chaîne locales ═════════════════════════════════
+   `const inputClass = "…"` / `let x = '…'` / `` const y = `…` `` déclarées
+   au niveau du fichier ou d'une fonction. Seule la première déclaration
+   d'un nom est retenue ; une redéclaration rend le nom NON RÉSOLU (on ne
+   choisit pas entre deux valeurs). Les gabarits gardent leur marqueur
+   `template` pour que les segments `${…}` soient comptés non résolus. */
+export function localStringConstants(text) {
+  const map = new Map();
+  const seen = new Set();
+  const re = /\b(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*(?::\s*string\s*)?=\s*(?:"((?:\\.|[^"\\\n])*)"|'((?:\\.|[^'\\\n])*)'|`([^`]*)`)\s*(?=[;,\n\r])/g;
+  for (const m of text.matchAll(re)) {
+    const name = m[1];
+    if (seen.has(name)) { map.delete(name); continue; }
+    seen.add(name);
+    if (m[4] !== undefined) map.set(name, { raw: m[4], template: true });
+    else map.set(name, { raw: m[2] !== undefined ? m[2] : m[3], template: false });
+  }
+  return map;
+}
+
 /* ══ Littéraux de classes, toutes syntaxes ═══════════════════════ */
 /**
  * Retourne les chaînes de classes d'un fichier, avec leur ligne.
@@ -68,6 +88,19 @@ export function classLiterals(text) {
   for (const m of text.matchAll(/(?:className|class)\s*=\s*(["'])([^"']*)\1/g)) push(m[2], m.index);
   for (const m of text.matchAll(/(?:className|class)\s*=\s*\{`([^`]*)`\}/g)) push(m[1], m.index, { template: true });
   for (const m of text.matchAll(/(?:className|class)\s*=\s*\{(["'])([^"']*)\1\}/g)) push(m[2], m.index);
+  /* Constantes locales de classes (pont §10, angle mort n°9) :
+       const inputClass = "…";  …  className={inputClass}
+     La valeur est écrite en clair dans le même fichier — la lire n'est pas
+     deviner. Chaque usage est jugé À SA LIGNE (un défaut dans la constante
+     est un défaut par usage), le littéral est résolu à chaque usage. Un
+     identifiant sans littéral local (import, prop, calcul) reste NON RÉSOLU,
+     compté, jamais interprété. */
+  const locals = localStringConstants(text);
+  for (const m of text.matchAll(/(?:className|class)\s*=\s*\{\s*([A-Za-z_$][\w$]*)\s*\}/g)) {
+    const value = locals.get(m[1]);
+    if (value === undefined) { unresolved += 1; continue; }
+    push(value.raw, m.index, { template: value.template });
+  }
   /* Vue / Svelte : :class="[…]", v-bind:class="…" — les littéraux entre quotes. */
   for (const m of text.matchAll(/(?::|v-bind:)class\s*=\s*(["'])([\s\S]*?)\1/g)) {
     for (const q of m[2].matchAll(/(["'`])([^"'`]*?)\1/g)) push(q[2], m.index + (q.index || 0), { template: q[1] === '`' });
