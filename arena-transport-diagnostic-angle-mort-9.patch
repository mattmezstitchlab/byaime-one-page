   ok(focus.top.some((i) => /incomplète|sans focus-visible/.test(i.message)), 'la paire incomplète n\'est pas nommée');
 });
 
+test('fixture class-constants (pont §10, angle mort n°9) — la constante est jugée par usage, à la ligne de l\'usage', () => {
+  const d = diagnoseV2(collect(FIX('class-constants')), REF);
+  const focus = d.families.find((f) => f.family === 'FOCUS');
+  eq(focus.count, 2, `FOCUS attendu 2 (inputClass utilisé deux fois), reçu ${focus.count}`);
+  /* les deux écarts portent la ligne de chaque usage, pas celle de la déclaration */
+  const lines = focus.top.map((i) => i.line).filter(Boolean).sort();
+  ok(lines.length === 2 && lines[0] !== lines[1], `deux lignes d\'usage distinctes attendues, reçu ${JSON.stringify(lines)}`);
+  ok(!focus.top.some((i) => /ring-ring/.test(i.message)), 'la paire valide (okClass) est facturée');
+});
+
+test('class-constants : ce qui n\'a pas de littéral local reste NON RÉSOLU — prop, import, redéclaration, segment ${…}', () => {
+  const d = diagnoseV2(collect(FIX('class-constants')), REF);
+  eq(d.unresolved, 4, `non résolu attendu 4 (cls, imported, twice, \${dynamic}), reçu ${d.unresolved}`);
+});
+
+test('localStringConstants : première déclaration retenue, redéclaration = retrait, gabarit marqué', () => {
+  const src = 'const a = "x";\nlet b = \'y\';\nconst c = `z ${n}`;\nvar d = "1"; var d = "2";\nconst e: string = "typed";\nconst f = fn("not a literal");\n';
+  const m = localStringConstants(src);
+  eq(m.get('a').raw, 'x', 'const double quote');
+  eq(m.get('b').raw, 'y', 'let simple quote');
+  ok(m.get('c').template === true && m.get('c').raw === 'z ${n}', 'gabarit marqué template');
+  ok(!m.has('d'), 'un nom redéclaré ne doit pas être résolu');
+  eq(m.get('e').raw, 'typed', 'annotation : string tolérée');
+  ok(!m.has('f'), 'un appel de fonction n\'est pas un littéral');
+});
+
 test('focus-pairing : aucun retrait d\'outline, aucun écart FOCUS inventé', () => {
   const dir = mkdtempSync(join(tmpdir(), 'aime-focus-ring-only-'));
