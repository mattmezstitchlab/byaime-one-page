{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/scheduled-messages",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "^/api$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/[...path].js"
    },
    {
      "src": "^/((?!api/|.*\\..*).*)$",
      "dest": "/index.html"
    }
  ]
}
