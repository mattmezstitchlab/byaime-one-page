{
  "name": "@workspace/byaime-onepage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:preview": "vite --config preview/vite.preview.mjs --configLoader runner --host 0.0.0.0",
    "build": "corepack pnpm --filter @workspace/api-server run build && vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "record:tour": "node scripts/record-tour.mjs"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@workspace/aime-domain": "workspace:*",
    "@workspace/api-client-react": "workspace:*",
    "clsx": "catalog:",
    "date-fns": "^3.6.0",
    "framer-motion": "catalog:",
    "jsdom": "^30.0.1",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "^5.4.0",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vitest": "^5.0.0",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  },
  "dependencies": {
    "@clerk/react": "^6.15.1",
    "@clerk/themes": "^2.4.57"
  }
}
