{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/byaime-onepage run build",
  "outputDirectory": "artifacts/byaime-onepage/dist/public",
  "crons": [
    {
      "path": "/api/cron/scheduled-messages",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "^/api$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/[...path].js"
    },
    {
      "src": "^/((?!api/|.*\\..*).*)$",
      "dest": "/index.html"
    }
  ]
}
