+    steps:
+      - id: decide
+        env:
+          HAS_CLERK_SECRET_KEY: ${{ secrets.CLERK_SECRET_KEY != '' }}
+          HAS_CLERK_PUBLISHABLE_KEY: ${{ secrets.CLERK_PUBLISHABLE_KEY != '' }}
+          IS_SAME_REPO: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
+        run: |
+          if [ "$HAS_CLERK_SECRET_KEY" = "true" ] && [ "$HAS_CLERK_PUBLISHABLE_KEY" = "true" ] && [ "$IS_SAME_REPO" = "true" ]; then
+            echo "run-e2e=true" >> "$GITHUB_OUTPUT"
+            echo "E2E : secrets Clerk présents, dépôt d'origine → lancement."
+          else
+            echo "run-e2e=false" >> "$GITHUB_OUTPUT"
+            echo "E2E : ignoré (secrets Clerk absents ou PR d'un fork). La gate CI sans secrets reste obligatoire."
+          fi
